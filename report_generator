import os
from datetime import datetime, timezone
from reportlab.lib.pagesizes import A4
from reportlab.lib import colors
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle

REPORTS_DIR = "./osint_reports"
os.makedirs(REPORTS_DIR, exist_ok=True)

def generate_osint_pdf(subject_data: dict, findings: list, risks: list, recommendations: list) -> str:
    subject_id = subject_data.get("subject_id", "OSINT_REPORT")
    file_path = os.path.join(REPORTS_DIR, f"{subject_id}_OSINT_Report.pdf")

    doc = SimpleDocTemplate(file_path, pagesize=A4, rightMargin=36, leftMargin=36, topMargin=36, bottomMargin=36)
    styles = getSampleStyleSheet()

    title_style = ParagraphStyle('DocTitle', parent=styles['Heading1'], fontSize=18, leading=22, textColor=colors.HexColor("#1A2B3C"))
    section_style = ParagraphStyle('SectionHeading', parent=styles['Heading2'], fontSize=13, leading=16, textColor=colors.HexColor("#2C3E50"), spaceBefore=14, spaceAfter=6)
    body_style = ParagraphStyle('Body', parent=styles['Normal'], fontSize=9, leading=12, textColor=colors.HexColor("#2C3E50"))

    story = []

    # Header
    story.append(Paragraph("<b>OSINT Intelligence Report</b>", title_style))
    story.append(Paragraph(f"Generated at: {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S UTC')}", body_style))
    story.append(Spacer(1, 12))

    # Executive Summary
    story.append(Paragraph("<b>Executive Summary</b>", section_style))
    summary_text = (
        f"This report analyzes subject {subject_data.get('handle','N/A')} across platforms "
        f"{', '.join(subject_data.get('platforms', []))}. Key findings highlight activity patterns, "
        f"network overlaps, and metadata correlations. Risks include potential influence operations "
        f"and suspicious cross-platform activity. Recommendations are provided for monitoring and "
        f"further investigation."
    )
    story.append(Paragraph(summary_text, body_style))
    story.append(Spacer(1, 15))

    # Subject Profile
    story.append(Paragraph("<b>1. Subject Profile</b>", section_style))
    profile_table = [
        ["Subject ID", subject_data.get("subject_id", "N/A")],
        ["Name / Handle", subject_data.get("handle", "N/A")],
        ["Platforms", ", ".join(subject_data.get("platforms", []))],
        ["Known Contacts", ", ".join(subject_data.get("contacts", []))],
    ]
    t_profile = Table(profile_table, colWidths=[150, 370])
    t_profile.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,0), colors.HexColor("#DDEEFF")),
        ('GRID', (0,0), (-1,-1), 0.5, colors.HexColor("#999999")),
        ('FONTNAME', (0,0), (-1,0), 'Helvetica-Bold')
    ]))
    story.append(t_profile)
    story.append(Spacer(1, 12))

    # Key Findings
    story.append(Paragraph("<b>2. Key Findings</b>", section_style))
    findings_data = [["Platform", "Content Snippet", "Metadata", "Confidence"]]
    for f in findings or []:
        findings_data.append([f.get("platform"), f.get("content")[:60]+"...", f.get("metadata"), f.get("confidence")])
    t_findings = Table(findings_data, colWidths=[80, 200, 150, 80])
    t_findings.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,0), colors.HexColor("#F0F0F0")),
        ('GRID', (0,0), (-1,-1), 0.5, colors.HexColor("#999999")),
        ('FONTNAME', (0,0), (-1,0), 'Helvetica-Bold')
    ]))
    story.append(t_findings)
    story.append(Spacer(1, 12))

    # Risk Assessment
    story.append(Paragraph("<b>3. Risk Assessment</b>", section_style))
    risk_data = [["Risk Type", "Description", "Severity"]]
    for r in risks or []:
        risk_data.append([r.get("type"), r.get("description"), r.get("severity")])
    t_risks = Table(risk_data, colWidths=[100, 250, 120])
    t_risks.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,0), colors.HexColor("#F0F0F0")),
        ('GRID', (0,0), (-1,-1), 0.5, colors.HexColor("#999999")),
        ('FONTNAME', (0,0), (-1,0), 'Helvetica-Bold')
    ]))
    story.append(t_risks)
    story.append(Spacer(1, 12))

    # Recommendations
    story.append(Paragraph("<b>4. Recommendations</b>", section_style))
    for rec in recommendations or []:
        story.append(Paragraph(f"• {rec}", body_style))

    doc.build(story)
    return file_path
